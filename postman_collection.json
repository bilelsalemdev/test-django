{
  "info": {
    "name": "Assessment API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "company_id", "value": "" },
    { "key": "client_id", "value": "" },
    { "key": "approval_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/register/", "host": ["{{base_url}}"], "path": ["api", "auth", "register", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bilelsalem2019@gmail.com\",\n  \"first_name\": \"Bilel\",\n  \"last_name\": \"Salem\",\n  \"password\": \"AZEwxc1234@\"\n}"
            }
          }
        },
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/register/", "host": ["{{base_url}}"], "path": ["api", "auth", "register", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bilelsalemdev@gmail.com\",\n  \"first_name\": \"Bilel\",\n  \"last_name\": \"Salem\",\n  \"password\": \"AZEwxc1234@\",\n  \"role\": \"admin\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access) {",
                  "    pm.collectionVariables.set('token', json.access);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/login/", "host": ["{{base_url}}"], "path": ["api", "auth", "login", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bilelsalem2019@gmail.com\",\n  \"password\": \"AZEwxc1234@\"\n}"
            },
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/token/refresh/", "host": ["{{base_url}}"], "path": ["api", "auth", "token", "refresh", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"your-refresh-token-here\"\n}"
            },
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "Companies",
      "item": [
        {
          "name": "Create Small Business",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data) {",
                  "    pm.collectionVariables.set('company_id', json.data.id);",
                  "    if (json.approval) pm.collectionVariables.set('approval_id', json.approval.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/companies/", "host": ["{{base_url}}"], "path": ["api", "companies", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Local Shop\",\n  \"type\": \"small_business\",\n  \"employee_count\": 15,\n  \"industry\": \"Retail\"\n}"
            }
          }
        },
        {
          "name": "Create Startup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/companies/", "host": ["{{base_url}}"], "path": ["api", "companies", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"TechStart\",\n  \"type\": \"startup\",\n  \"funding_stage\": \"Series A\",\n  \"founded_year\": 2022\n}"
            }
          }
        },
        {
          "name": "Create Corporate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/companies/", "host": ["{{base_url}}"], "path": ["api", "companies", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"MegaCorp\",\n  \"type\": \"corporate\",\n  \"revenue\": \"5000000.00\",\n  \"stock_symbol\": \"MEGA\"\n}"
            }
          }
        },
        {
          "name": "List Companies",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/companies/", "host": ["{{base_url}}"], "path": ["api", "companies", ""] }
          }
        },
        {
          "name": "Get Company",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/companies/{{company_id}}/", "host": ["{{base_url}}"], "path": ["api", "companies", "{{company_id}}", ""] }
          }
        }
      ]
    },
    {
      "name": "Clients",
      "item": [
        {
          "name": "Create Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data) {",
                  "    pm.collectionVariables.set('client_id', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/clients/", "host": ["{{base_url}}"], "path": ["api", "clients", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Bilel\",\n  \"last_name\": \"Salem\",\n  \"email\": \"bilel.salem@company.com\",\n  \"phone\": \"+21628206707\",\n  \"company\": \"{{company_id}}\"\n}"
            }
          }
        },
        {
          "name": "List Clients",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/clients/", "host": ["{{base_url}}"], "path": ["api", "clients", ""] }
          }
        },
        {
          "name": "Get Client",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/clients/{{client_id}}/", "host": ["{{base_url}}"], "path": ["api", "clients", "{{client_id}}", ""] }
          }
        }
      ]
    },
    {
      "name": "Approvals",
      "item": [
        {
          "name": "List Approvals (Admin)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/approvals/", "host": ["{{base_url}}"], "path": ["api", "approvals", ""] }
          }
        },
        {
          "name": "Approve (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/approvals/{{approval_id}}/", "host": ["{{base_url}}"], "path": ["api", "approvals", "{{approval_id}}", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            }
          }
        },
        {
          "name": "Reject (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/approvals/{{approval_id}}/", "host": ["{{base_url}}"], "path": ["api", "approvals", "{{approval_id}}", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\"\n}"
            }
          }
        }
      ]
    }
  ]
}
